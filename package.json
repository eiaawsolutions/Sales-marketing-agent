{
  "name": "sales-marketing-agent",
  "version": "1.0.0",
  "description": "AI-powered sales & marketing automation agent",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --import ./src/bootstrap/secrets.js src/server.js",
    "dev": "node --watch --import ./src/bootstrap/secrets.js src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "seed": "node src/db/seed.js",
    "stamp": "node scripts/stamp-version.js",
    "deploy": "node scripts/stamp-version.js && railway up --detach --no-gitignore",
    "release": "node scripts/deploy-and-refresh.js",
    "ship": "npm run deploy && npm run release"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.4.15",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsdom": "^29.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "resend": "^6.12.2",
    "speakeasy": "^2.0.0",
    "stripe": "^22.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "railway": "3.11.0"
  }
}
