# ── Infisical bootstrap: the ONLY raw secrets allowed in env (EIAAW Deploy Contract)
# The machine identity must hold secrets:read on the eiaaw-all-projects workspace.
INFISICAL_RESOLVER_ENABLED=false        # production: true
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_APP_CLIENT_ID=
INFISICAL_APP_CLIENT_SECRET=
INFISICAL_PROJECT_ID=                   # eiaaw-all-projects workspace ID
# INFISICAL_REQUEST_TIMEOUT_MS=5000

# ── Secrets: Infisical handles, resolved at boot by src/bootstrap/secrets.js.
# Allow-list and required/optional split: src/config/secrets.js.
# Locally (resolver off) you may put a raw dev value here instead.
# These match production. Sales Agent keys are prefixed SALES_AGENT_ so they are
# never confused with another service's (e.g. Workforce's STRIPE_WEBHOOK_SECRET,
# or the estate-wide ANTHROPIC_API_KEY, which is a different account).
ENCRYPTION_KEY=secret://eiaaw-all-projects/prod/SALES_AGENT_ENCRYPTION_KEY
ANTHROPIC_API_KEY=secret://eiaaw-all-projects/prod/SALES_AGENT_ANTHROPIC_API_KEY
STRIPE_WEBHOOK_SECRET=secret://eiaaw-all-projects/prod/SALES_AGENT_STRIPE_WEBHOOK_SECRET
VOICE_REFRESH_TOKEN=secret://eiaaw-all-projects/prod/VOICE_REFRESH_TOKEN
RESEND_API_KEY=secret://eiaaw-all-projects/prod/RESEND_API_KEY
# Signing secret (whsec_...) of the Resend webhook that points at /api/tracking/webhook
RESEND_WEBHOOK_SIGNING_SECRET=secret://eiaaw-all-projects/prod/RESEND_WEBHOOK_SIGNING_SECRET
SMTP_PASS=secret://eiaaw-all-projects/prod/SALES_AGENT_SMTP_PASS
# Website reader (Crawl4AI) token. The one foldered secret, on purpose: an
# Infisical sync copies EVERY secret in its source folder, and the crawl4ai
# service gets this token through Infisical's Railway sync. Syncing from the
# root would hand that third-party container every EIAAW secret. So the token
# lives alone in /crawl4ai and the sync reads only that folder. On Railway,
# crawl4ai's own CRAWL4AI_API_TOKEN is the reference
# ${{SALES_AGENT_CRAWL4AI_API_TOKEN}}. Missing → dropped at boot, reader off.
CRAWL4AI_API_TOKEN=secret://eiaaw-all-projects/prod/crawl4ai/SALES_AGENT_CRAWL4AI_API_TOKEN
# Only if the reacher service sets RCH__HEADER_SECRET (it runs without one,
# reachable on the private network only):
# REACHER_SECRET=secret://eiaaw-all-projects/prod/SALES_AGENT_REACHER_SECRET

# ── Non-secret config (raw values are fine)
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
FROM_EMAIL=
# Self-hosted lead tools on the Railway private network. Unset → off.
CRAWL4AI_URL=                           # production: http://crawl4ai.railway.internal:11235
REACHER_URL=                            # production: http://reacher.railway.internal:8080
# REACHER_PROBE_EMAIL=postmaster@eiaawsolutions.com   # address the port-25 self-test checks
